# Base de datos PostgreSQL
DATABASE_URL="postgresql://zenmind:zenmind@localhost:5432/zenmind?schema=public"

# Puerto de la API
PORT=3000

# Prefijo global de la API
API_PREFIX=api

# JWT
JWT_ACCESS_SECRET="cambia-esto-en-produccion-access"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="cambia-esto-en-produccion-refresh"
JWT_REFRESH_EXPIRES_IN="30d"

# Google Sign-In (OpenID / OAuth)
# Client IDs válidos para validar el ID token (web, Android, iOS).
# Separa varios con coma. NO pongas secretos reales en este archivo de ejemplo.
GOOGLE_CLIENT_IDS="TU_CLIENT_ID_WEB.apps.googleusercontent.com,TU_CLIENT_ID_ANDROID.apps.googleusercontent.com"

# Entorno
NODE_ENV=development
